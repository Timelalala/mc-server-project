PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password
DB_NAME=mc_server_db
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRE=7d

# Raspberry Pi SSH config templates
# For Server A
SSH_HOST_A=192.168.1.11
SSH_USER_A=pi
SSH_PASS_A=your_pi_password
# For Server B
SSH_HOST_B=192.168.1.12
SSH_USER_B=pi
SSH_PASS_B=your_pi_password
# For Server C
SSH_HOST_C=192.168.1.13
SSH_USER_C=pi
SSH_PASS_C=your_pi_password

# Omise PromptPay Keys
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxx

# Minecraft RCON Config (Pi 1 - 4)
RCON_TIMEOUT=5000
RCON_SIMULATION_MODE=false

# Server 1 (Java Survival)
RCON_HOST_1=192.168.1.11
RCON_PORT_1=25575
RCON_PASSWORD_1=your_rcon_password_1

# Server 2 (RLCraft)
RCON_HOST_2=192.168.1.12
RCON_PORT_2=25575
RCON_PASSWORD_2=your_rcon_password_2

# Server 3 (RL Dregora)
RCON_HOST_3=192.168.1.13
RCON_PORT_3=25575
RCON_PASSWORD_3=your_rcon_password_3

# Server 4 (Pixelmon)
