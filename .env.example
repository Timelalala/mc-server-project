# ==============================================================================
# Environment Configuration Template for Docker Deployment
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Timezone
TZ=Asia/Bangkok

# MySQL Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=mc_db_secret_pass_2026
DB_NAME=mc_server_db
MYSQL_ROOT_PASSWORD=mc_db_secret_pass_2026

# Backend Configuration
PORT=5000
JWT_SECRET=mc_server_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:5173

# MC Cluster Security Key (matches /etc/mc-slot/web_key on MC1)
MC_API_KEY=your_cluster_secret_key_here

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=/api

# Payment Gateway (Optional / Production)
OMISE_PUBLIC_KEY=pkey_test_xxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxx
EASYSLIP_API_KEY=your_easyslip_token
EASYSLIP_BANK_ACCOUNT=your_bank_account
